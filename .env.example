# Base URL of the Backlog Tracker backend (NestJS). Every API request goes through the Axios client in
# src/lib/apiClient.ts, which reads this. The browser may only call it from the address the backend allows (CORS_ORIGIN).
# Use an https:// address in production: passwords are sent to this API.
NEXT_PUBLIC_API_URL=http://172.16.17.37:3000/api

# --- Live updates over Socket.IO (optional; leave unset and the app makes no socket connection) ---
# The address of the backend's Socket.IO server (same host as the API, without /api). The browser sends the sign-in token in the handshake.
# NEXT_PUBLIC_SOCKET_URL=http://172.16.17.37:3000
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
# Event names are PROPOSED (see src/types/socket.ts); override them here once the backend's real names are agreed.
# NEXT_PUBLIC_SOCKET_EVENT_CHANGE=task:status:change
# NEXT_PUBLIC_SOCKET_EVENT_CHANGED=task:status:changed

# --- Notifications ---
# The list, unread count and read state always come from the backend REST API (/notifications...). Live delivery needs the address of the real notification
# WebSocket server (ws:// or wss://). Leave it unset and the bell has no live connection: it says so and refreshes from REST every minute. Nothing is simulated.
# NEXT_PUBLIC_NOTIFICATIONS_WS_URL=wss://api.example.com/notifications
# How the socket authenticates: "message" (default, token in the first frame) or "query" (token as ?token= in the address).
# NEXT_PUBLIC_NOTIFICATIONS_WS_AUTH=message
